; Godot project configuration
config_version=5

[application]
config/name="고물용사 · Garbage Hero"
config/version="0.3.0"
config/use_custom_user_dir=true
config/custom_user_dir_name="GarbageHero"
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]
common/physics_ticks_per_second=60

[internationalization]
locale/fallback="ko"

[rendering]
renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.31, 0.48, 0.54, 1)

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
move_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
dodge={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
hook={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
spin={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
slam={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
inventory={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":73)]}
skills={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":75)]}
map={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":77)]}
attack={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1)]}
